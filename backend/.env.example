# FinCore 5K - Backend environment
PORT=3000

# MongoDB (Replica Set obrigatorio para multi-document transactions / sessions)
MONGO_URI=mongodb://root:password@localhost:27017/fincore?replicaSet=rs0
MONGO_MAX_POOL_SIZE=100
MONGO_MIN_POOL_SIZE=20

# Redis Cluster (Locks, Idempotencia, Cache e filas BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Redlock
REDLOCK_TTL_MS=2000
REDLOCK_ACQUIRE_TIMEOUT_MS=500

# WebSocket
WS_CORS_ORIGIN=http://localhost:3001
